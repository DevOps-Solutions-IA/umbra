<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground (108dp). The symbol is scaled x2.6 and centered; its farthest
     point is ~30.2dp from the center, inside the 33dp (66dp diameter) safe zone of every mask.
     Also used as monochrome layer (alpha only) and as the Android 12 splash icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
  <group android:translateX="22.8" android:translateY="22.67" android:scaleX="2.6" android:scaleY="2.6">
    <path android:fillColor="@color/umbra_symbol" android:pathData="@string/umbra_symbol_path"/>
  </group>
</vector>

   std::unique_ptr<SessionDescription> Clone() const;

+  // UMBRA policy over the upstream parsed SDP model, not a textual SDP filter.
+  // No data/unsupported section, multiple audio/video sections or multiple tracks.
+  bool IsUmbraOneToOneMedia() const {
+    int audio = 0;
+    int video = 0;
+    for (const auto& content : contents_) {
+      const auto* media = content.media_description();
+      if (!media || media->streams().size() > 1) return false;
+      switch (media->type()) {
+        case MediaType::AUDIO: ++audio; break;
+        case MediaType::VIDEO: ++video; break;
+        default: return false;
+      }
+    }
+    return audio == 1 && video <= 1;
+  }
+
   // Content accessors.
   const ContentInfos& contents() const { return contents_; }
   ContentInfos& contents() { return contents_; }

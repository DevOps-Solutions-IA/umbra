+TEST(UmbraMediaPolicyTest, RejectsEmptyAndVideoOnly) {
+  SessionDescription description;
+  EXPECT_FALSE(description.IsUmbraOneToOneMedia());
+  description.AddContent("video", MediaProtocolType::kRtp,
+                         std::make_unique<VideoContentDescription>());
+  EXPECT_FALSE(description.IsUmbraOneToOneMedia());
+}
+TEST(UmbraMediaPolicyTest, AcceptsAudioAndOneVideo) {
+  SessionDescription description;
+  description.AddContent("audio", MediaProtocolType::kRtp,
+                         std::make_unique<AudioContentDescription>());
+  EXPECT_TRUE(description.IsUmbraOneToOneMedia());
+  description.AddContent("video", MediaProtocolType::kRtp,
+                         std::make_unique<VideoContentDescription>());
+  EXPECT_TRUE(description.IsUmbraOneToOneMedia());
+}
+TEST(UmbraMediaPolicyTest, RejectsDataEvenWhenRejected) {
+  for (bool rejected : {false, true}) {
+    SessionDescription description;
+    description.AddContent("audio", MediaProtocolType::kRtp,
+                           std::make_unique<AudioContentDescription>());
+    description.AddContent("data", MediaProtocolType::kSctp, rejected,
+                           std::make_unique<SctpDataContentDescription>());
+    EXPECT_FALSE(description.IsUmbraOneToOneMedia());
+  }
+}
+TEST(UmbraMediaPolicyTest, RejectsDuplicateAudio) {
+  SessionDescription description;
+  description.AddContent("a1", MediaProtocolType::kRtp,
+                         std::make_unique<AudioContentDescription>());
+  description.AddContent("a2", MediaProtocolType::kRtp,
+                         std::make_unique<AudioContentDescription>());
+  EXPECT_FALSE(description.IsUmbraOneToOneMedia());
+}
+TEST(UmbraMediaPolicyTest, RejectsDuplicateVideo) {
+  SessionDescription description;
+  description.AddContent("audio", MediaProtocolType::kRtp,
+                         std::make_unique<AudioContentDescription>());
+  description.AddContent("v1", MediaProtocolType::kRtp,
+                         std::make_unique<VideoContentDescription>());
+  description.AddContent("v2", MediaProtocolType::kRtp,
+                         std::make_unique<VideoContentDescription>());
+  EXPECT_FALSE(description.IsUmbraOneToOneMedia());
+}
+TEST(UmbraMediaPolicyTest, RejectsMultipleTracksInOneSection) {
+  SessionDescription description;
+  auto audio = std::make_unique<AudioContentDescription>();
+  audio->AddLegacyStream(1);
+  EXPECT_EQ(1u, audio->streams().size());
+  audio->AddLegacyStream(2);
+  EXPECT_EQ(2u, audio->streams().size());
+  description.AddContent("audio", MediaProtocolType::kRtp, std::move(audio));
+  EXPECT_FALSE(description.IsUmbraOneToOneMedia());
+}

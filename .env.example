# Public DNS name under your control; do not include https:// or a path.
UMBRA_DOMAIN=chat.example.com
# Public realm exported by the deliberately created Android admission authority.
# Format: umbra:realm:1:<realmId>:<authorityPublicKey>:<authorityKeyId>
# Use the exact exported public wire; never put a private seed here.
UMBRA_ADMISSION_REALM=
# UMBRA_ADMISSION_ORIGIN is derived as https://${UMBRA_DOMAIN} by Compose.
